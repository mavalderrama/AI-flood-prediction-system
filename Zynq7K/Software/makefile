# Flood forecaster for the Zynq + host tests.
#
#   make arm        cross-compile predictor.bin for the board
#                   (needs xtopann_hw.h generated by Vivado/HLS/run_hls.tcl)
#   make host-test  build and run the tests on the development machine
#                   (simulated register map, no hardware needed)
#
# Cross compiler selection for `make arm`:
#   * Yocto/EDF SDK sourced (environment-setup-*): uses its $CXX (which
#     carries --sysroot and the hard-float flags) and its CXXFLAGS/LDFLAGS.
#   * BitBake recipe (Yocto/meta-flood): passes TARGET_CXX, TARGET_CXXFLAGS
#     and TARGET_LDFLAGS explicitly.
#   * Otherwise: $(CROSS)g++ (e.g. CROSS=arm-linux-gnueabihf-) and no flags
#     from the environment, so a host CXXFLAGS/LDFLAGS cannot leak in.
# Paths and the output name are set here (override them on the command line,
# not through the environment).

CROSS    ?= arm-linux-gnueabihf-
HOST_CXX ?= c++
HLS_DIR       := ../../Vivado/HLS
REPLAY        := ../../data/processed/golden_replay.csv
BUILD         := build
PREDICTOR_OUT := predictor.bin

ifdef OECORE_TARGET_SYSROOT
TARGET_CXX      ?= $(CXX)
TARGET_CXXFLAGS ?= $(CXXFLAGS)
TARGET_LDFLAGS  ?= $(LDFLAGS)
else
TARGET_CXX      ?= $(CROSS)g++
endif

# -ffp-contract=off: no fused multiply-add, so features/normalization round
# exactly like the Python reference. _FILE_OFFSET_BITS=64: 64-bit off_t for
# mmap of physical addresses on 32-bit ARM.
APP_CXXFLAGS := -std=c++11 -O2 -Wall -Wextra -ffp-contract=off -D_FILE_OFFSET_BITS=64 -I. -I$(HLS_DIR)
SRCS         := ANN.cpp ann_ref.cpp features.cpp
SIM          := -DANN_REGS_HEADER='"tests/xtopann_hw_sim.h"'

.PHONY: arm host-test clean

arm: $(PREDICTOR_OUT)

$(PREDICTOR_OUT): $(SRCS) predictor.cpp xtopann_hw.h
	$(TARGET_CXX) $(TARGET_CXXFLAGS) $(APP_CXXFLAGS) $(SRCS) predictor.cpp $(TARGET_LDFLAGS) -o $@

$(BUILD)/test_driver: tests/test_driver.cpp $(SRCS) tests/xtopann_hw_sim.h
	@mkdir -p $(BUILD)
	$(HOST_CXX) $(APP_CXXFLAGS) $(SIM) tests/test_driver.cpp $(SRCS) -o $@

$(BUILD)/predictor_host: predictor.cpp $(SRCS) tests/xtopann_hw_sim.h
	@mkdir -p $(BUILD)
	$(HOST_CXX) $(APP_CXXFLAGS) $(SIM) predictor.cpp $(SRCS) -o $@

host-test: $(BUILD)/test_driver $(BUILD)/predictor_host
	./$(BUILD)/test_driver
	./$(BUILD)/predictor_host --cpu-only --check --quiet --replay $(REPLAY)

clean:
	rm -rf $(BUILD) $(PREDICTOR_OUT)
