# Flood forecaster for the Zynq (Petalinux) + host tests.
#
#   make arm        cross-compile predictor.bin for the board
#                   (needs xtopann_hw.h generated by Vivado/HLS/run_hls.tcl)
#   make host-test  build and run the tests on the development machine
#                   (simulated register map, no hardware needed)

CROSS    ?= arm-linux-gnueabihf-
HOST_CXX ?= c++
HLS_DIR  := ../../Vivado/HLS
REPLAY   := ../../data/processed/golden_replay.csv
BUILD    := build

# -ffp-contract=off: no fused multiply-add, so features/normalization round
# exactly like the Python reference.
CXXFLAGS := -std=c++11 -O2 -Wall -Wextra -ffp-contract=off -I. -I$(HLS_DIR)
SRCS     := ANN.cpp ann_ref.cpp features.cpp
SIM      := -DANN_REGS_HEADER='"tests/xtopann_hw_sim.h"'

.PHONY: arm host-test clean

arm: predictor.bin

predictor.bin: $(SRCS) predictor.cpp xtopann_hw.h
	$(CROSS)g++ $(CXXFLAGS) $(SRCS) predictor.cpp -o $@

$(BUILD)/test_driver: tests/test_driver.cpp $(SRCS) tests/xtopann_hw_sim.h
	@mkdir -p $(BUILD)
	$(HOST_CXX) $(CXXFLAGS) $(SIM) tests/test_driver.cpp $(SRCS) -o $@

$(BUILD)/predictor_host: predictor.cpp $(SRCS) tests/xtopann_hw_sim.h
	@mkdir -p $(BUILD)
	$(HOST_CXX) $(CXXFLAGS) $(SIM) predictor.cpp $(SRCS) -o $@

host-test: $(BUILD)/test_driver $(BUILD)/predictor_host
	./$(BUILD)/test_driver
	./$(BUILD)/predictor_host --cpu-only --check --quiet --replay $(REPLAY)

clean:
	rm -rf $(BUILD) predictor.bin
